  records.forEach(r => {
    if (r.status && counts[r.status] !== undefined) counts[r.status]++;
    else counts.none++;
  });
  const sumRows = [
    ['统计项','数值'],
    ['学生总数', students.length],
    ['本轮已点名', records.length],
