let students = [];
let records = [];
let mode = 'random';
let pickedIds = [];
let currentStudentId = null;
let currentRecordId = null;
let importPreview = [];

const $  = s => document.querySelector(s);
const $$ = s => Array.from(document.querySelectorAll(s));

function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
function nowStr() {
  const d = new Date(), p = n => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
}
function escapeHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, c =>
    ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]));
}
let toastTimer = null;
function toast(msg, duration = 1900) {
  const el = $('#toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), duration);
}

function save() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ students, records, mode, pickedIds })); }
  catch (e) { console.warn('保存失败', e); }
}
function load() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return;
    const d = JSON.parse(raw);
    students  = Array.isArray(d.students) ? d.students : [];
    records   = Array.isArray(d.records)  ? d.records  : [];
    mode      = d.mode === 'sequential' ? 'sequential' : 'random';
    pickedIds = Array.isArray(d.pickedIds) ? d.pickedIds : [];
  } catch (e) { console.warn('读取失败', e); }
}

/* ================= 点名核心 ================= */
function doPick() {
  if (students.length === 0) {
    toast('请先添加或导入学生名单');
    switchPage('students');
    return;
  }
  const remaining = students.filter(s => !pickedIds.includes(s.id));
  if (remaining.length === 0) {
    if (confirm('本轮所有学生都已点过，是否开始新一轮？')) {
      pickedIds = []; currentStudentId = null; currentRecordId = null;
      save(); doPick();
    }
    return;
  }
  const student = mode === 'random'
    ? remaining[Math.floor(Math.random() * remaining.length)]
    : remaining[0];

  pickedIds.push(student.id);
  currentStudentId = student.id;

  const rec = {
    id: uid(), studentId: student.id, name: student.name,
    studentNo: student.studentNo || '', className: student.className || '',
    mode, status: null, time: nowStr()
  };
  records.push(rec);
  currentRecordId = rec.id;

  showCurrent(student);
  speak(student.name);
  renderAll();
}

function showCurrent(student) {
  const nameEl = $('#pickName');
  nameEl.textContent = student.name;
  nameEl.classList.remove('pop');
  void nameEl.offsetWidth;
  nameEl.classList.add('pop');

  const metaParts = [];
  if (student.studentNo) metaParts.push('学号：' + student.studentNo);
  if (student.className) metaParts.push(student.className);
  $('#pickMeta').textContent = metaParts.length ? metaParts.join(' · ') : '请选择出勤状态';

  $('#statusGrid').classList.add('show');
  $('#pickBtn').textContent = '下 一 位 →';
}

function markStatus(status) {
  if (!currentRecordId) { toast('请先点名'); return; }
  const rec = records.find(r => r.id === currentRecordId);
  if (!rec) return;
  rec.status = status;
  const info = STATUS_MAP[status];
  toast(`${rec.name} 已标记为「${info.text}」`);
  renderAll();

  if ($('#autoNext').checked) {
    setTimeout(() => {
      if (students.filter(s => !pickedIds.includes(s.id)).length > 0) {
        doPick();
      } else {
        $('#pickBtn').textContent = '本 轮 已 完 成';
        $('#statusGrid').classList.remove('show');
      }
    }, 380);
  }
}

function resetRound() {
  if (records.length === 0 && pickedIds.length === 0) { toast('当前没有记录'); return; }
  if (!confirm('确定要清空本轮点名记录并重新开始吗？')) return;
  records = []; pickedIds = [];
  currentStudentId = null; currentRecordId = null;
  $('#pickName').textContent = '准备就绪';
  $('#pickMeta').textContent = '点击下方按钮开始点名';
  $('#pickBtn').textContent = '开 始 点 名';
  $('#statusGrid').classList.remove('show');
  save(); renderAll();
  toast('已开始新一轮');
}

function speak(text) {
  if (!$('#voiceOn').checked) return;
  try {
    if (!('speechSynthesis' in window)) return;
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'zh-CN'; u.rate = 0.95; u.pitch = 1.05;
    speechSynthesis.speak(u);
  } catch (e) {}
}

