/* ================= 微信群文本解析 ================= */
function parseWechatMembers(rawText) {
  const lines = String(rawText).split(/\r?\n/);
  const seen = new Set();
  const result = [];
  const skipExact = [
    '群成员','群聊成员','查看更多','展开','收起','返回','确定','取消',
    '删除','添加','移出','设置','聊天信息','群公告','公告','群主',
    '管理员','老师','班主任','辅导员','任课老师','所有人'
  ];
  for (let raw of lines) {
    let line = String(raw).trim();
    if (!line) continue;
    if (/^[\d\s\.、,，\-—_]+$/.test(line)) continue;
    if (skipExact.includes(line)) continue;
    if (/^(群成员|群聊成员)\s*[（(]?\d*[)）]?$/.test(line)) continue;
    if (/^(共)?\s*\d+\s*(人|位成员)$/.test(line)) continue;
    if (/^\d+\s*人$/.test(line)) continue;

    line = line.replace(/^\d+\s*[\.、\)）]\s*/, '');
    let name = line
      .replace(/[（(][^（()）]*[)）]/g, '')
      .replace(/\[[^\]]*\]/g, '')
      .replace(/【[^】]*】/g, '');
    if (!name.trim()) name = line;

    name = name.replace(/[^\u4e00-\u9fa5a-zA-Z0-9·\s]/g, '').replace(/\s+/g, '').trim();
    if (name.length < 2 || name.length > 20) continue;
    if (/^\d+$/.test(name)) continue;
    if (/^[a-zA-Z0-9_]{15,}$/.test(name)) continue;
    if (seen.has(name)) continue;
    seen.add(name);
    result.push({ name, raw: line, checked: true });
  }
  return result;
}
