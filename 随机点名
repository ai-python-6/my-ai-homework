}

/* ================= Excel / CSV 导入 ================= */
function handleExcelFile(file) {
  const fname = file.name.toLowerCase();
  const isCsv = fname.endsWith('.csv');

  // 情况 A：XLSX 已就绪
  if (typeof XLSX !== 'undefined') {
    const reader = new FileReader();
    reader.onload = e => {
      try {
        const data = new Uint8Array(e.target.result);
        const wb = XLSX.read(data, { type: 'array' });
        const ws = wb.Sheets[wb.SheetNames[0]];
        const rows = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });
        importRowsFromArray(rows, file.name);
      } catch (err) {
        console.error(err);
        toast('文件解析失败：' + err.message);
      }
    };
    reader.onerror = () => toast('文件读取失败，请重试');
    reader.readAsArrayBuffer(file);
    return;
  }

  // 情况 B：XLSX 未加载，但是 CSV → 直接解析
  if (isCsv) {
    const reader = new FileReader();
    reader.onload = e => {
      try {
        const rows = parseCSV(e.target.result);
        importRowsFromArray(rows, file.name);
      } catch (err) {
        console.error(err);
        toast('CSV 解析失败：' + err.message);
      }
    };
    reader.readAsText(file, 'UTF-8');
    return;
  }

  // 情况 C：XLSX 未加载，用户传 .xlsx
  alert(
    '📋 Excel 解析库未能加载（可能是网络问题）\n\n' +
    '解决方案（任选其一）：\n' +
    '1️⃣ 刷新页面重试（推荐先试这个）\n' +
    '2️⃣ 用 Excel 打开文件 → 另存为「CSV UTF-8(逗号分隔)」→ 重新导入 CSV\n' +
    '3️⃣ 改用「微信群成员导入」文本框方式手动粘贴名单\n\n' +
    'CSV 文件本系统可完美解析，不影响功能。'
  );
}

function importRowsFromArray(rows, fileName) {
  if (!rows || rows.length === 0) { toast('文件内容为空'); return; }

  let headerRow = -1, nameCol = 0, noCol = -1, clsCol = -1;
  for (let i = 0; i < Math.min(rows.length, 5); i++) {
    const row = (rows[i] || []).map(c => String(c == null ? '' : c).trim());
    const ni = row.findIndex(c => /^(姓名|名字|学生姓名|name)$/i.test(c));
    if (ni >= 0) {
      headerRow = i; nameCol = ni;
      noCol  = row.findIndex(c => /^(学号|学籍号|编号|no|id)$/i.test(c));
      clsCol = row.findIndex(c => /^(班级|小组|组别|class)$/i.test(c));
      break;
    }
  }

  const startIdx = headerRow >= 0 ? headerRow + 1 : 0;
  const parsed = [];
  const seen = new Set();

  for (let i = startIdx; i < rows.length; i++) {
    const row = rows[i] || [];
    if (row.length === 0) continue;
    const name = String(row[nameCol] == null ? '' : row[nameCol]).trim();
    if (!name || name.length > 20) continue;
    if (seen.has(name)) continue;
    seen.add(name);
    parsed.push({
      name,
      studentNo: noCol >= 0 ? String(row[noCol] == null ? '' : row[noCol]).trim() : '',
      className: clsCol >= 0 ? String(row[clsCol] == null ? '' : row[clsCol]).trim() : ''
    });
  }

  if (parsed.length === 0) {
    toast('未解析到有效学生数据，请检查表头是否为「姓名」');
    return;
  }

  const existingNames = new Set(students.map(s => s.name));
  let added = 0, skipped = 0;
  parsed.forEach(p => {
    if (existingNames.has(p.name)) { skipped++; return; }
    students.push({ id: uid(), name: p.name, studentNo: p.studentNo, className: p.className });
    existingNames.add(p.name);
    added++;
  });
  save(); renderAll();
  toast(`导入成功 ${added} 人${skipped ? `，跳过重复 ${skipped} 人` : ''}`);
}

/* 轻量 CSV 解析器（支持引号、逗号、换行） */
function parseCSV(text) {
  if (text.charCodeAt(0) === 0xFEFF) text = text.slice(1);
  const rows = [];
  let row = [], cur = '', inQuote = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i], next = text[i + 1];
    if (inQuote) {
      if (ch === '"' && next === '"') { cur += '"'; i++; }
      else if (ch === '"') { inQuote = false; }
      else cur += ch;
    } else {
      if (ch === '"') inQuote = true;
      else if (ch === ',') { row.push(cur); cur = ''; }
      else if (ch === '\r') {}
      else if (ch === '\n') { row.push(cur); rows.push(row); row = []; cur = ''; }
      else cur += ch;
    }
  }
  if (cur !== '' || row.length > 0) { row.push(cur); rows.push(row); }
  return rows;
}

/* ================= 导出 ================= */
