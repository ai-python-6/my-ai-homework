function exportAsCSV() {
  if (students.length === 0 && records.length === 0) { toast('暂无数据可导出'); return; }
  const esc = v => {
    const s = String(v == null ? '' : v);
    return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  };
  const lines = [];
  lines.push(['序号','姓名','学号','班级/小组','点名方式','出勤状态','点名时间'].map(esc).join(','));
  const recordedIds = new Set(records.map(r => r.studentId));
  let idx = 1;
  records.forEach(r => {
    lines.push([idx++, r.name, r.studentNo || '', r.className || '',
      r.mode === 'random' ? '随机' : '顺序',
      r.status ? STATUS_MAP[r.status].text : '未标记', r.time].map(esc).join(','));
  });
  students.filter(s => !recordedIds.has(s.id)).forEach(s => {
    lines.push([idx++, s.name, s.studentNo || '', s.className || '', '-', '未点名', ''].map(esc).join(','));
  });
  const blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `点名报表_${new Date().toISOString().slice(0, 10)}.csv`;
  document.body.appendChild(a); a.click();
  document.body.removeChild(a); URL.revokeObjectURL(url);
  toast('已导出 CSV（Excel 可直接打开）');
}

function exportStudentList() {
  if (students.length === 0) { toast('名单为空'); return; }

  if (typeof XLSX === 'undefined') {
    // CSV 兜底
    const esc = v => {
      const s = String(v == null ? '' : v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    };
    const lines = [['序号','姓名','学号','班级/小组'].map(esc).join(',')];
    students.forEach((s, i) => lines.push([i + 1, s.name, s.studentNo || '', s.className || ''].map(esc).join(',')));
    const blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `学生名单_${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a); a.click();
    document.body.removeChild(a); URL.revokeObjectURL(url);
    toast('已导出 CSV 名单');
    return;
  }

  const rows = [['序号','姓名','学号','班级/小组']];
  students.forEach((s, i) => rows.push([i + 1, s.name, s.studentNo || '', s.className || '']));
  const ws = XLSX.utils.aoa_to_sheet(rows);
  ws['!cols'] = [{wch:6},{wch:12},{wch:15},{wch:16}];
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, '学生名单');
  XLSX.writeFile(wb, `学生名单_${new Date().toISOString().slice(0, 10)}.xlsx`);
  toast('名单已导出');
}

/* ================= 页面切换 & 事件绑定 ================= */
function switchPage(name) {
  $$('.page').forEach(p => p.classList.remove('active'));
  const target = $('#page-' + name);
  if (target) target.classList.add('active');
  $$('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.page === name));
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function bindEvents() {
  $$('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => switchPage(btn.dataset.page));
  });

  $$('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      mode = btn.dataset.mode;
      $$('.mode-btn').forEach(b => b.classList.toggle('active', b === btn));
      pickedIds = []; currentStudentId = null; currentRecordId = null;
      $('#pickName').textContent = '准备就绪';
      $('#pickMeta').textContent = mode === 'random'
        ? '随机模式 · 点击开始点名'
        : '顺序模式 · 按名单顺序点名';
      $('#pickBtn').textContent = '开 始 点 名';
      $('#statusGrid').classList.remove('show');
      save(); renderAll();
      toast(mode === 'random' ? '已切换：随机点名' : '已切换：顺序点名');
    });
  });

  $('#pickBtn').addEventListener('click', doPick);

  $$('.status-btn').forEach(btn => {
    btn.addEventListener('click', () => markStatus(btn.dataset.status));
  });

  $('#resetRound').addEventListener('click', resetRound);

  $('#addBtn').addEventListener('click', addStudent);
  $('#addName').addEventListener('keydown', e => { if (e.key === 'Enter') addStudent(); });
  $('#addNo').addEventListener('keydown', e => { if (e.key === 'Enter') addStudent(); });
  $('#stuSearch').addEventListener('input', renderStudents);

  $('#studentList').addEventListener('click', e => {
    const delBtn = e.target.closest('[data-del]');
    const editBtn = e.target.closest('[data-edit]');
    if (delBtn) deleteStudent(delBtn.dataset.del);
    if (editBtn) editStudent(editBtn.dataset.edit);
  });

  $('#clearStuBtn').addEventListener('click', clearStudents);
  $('#exportStuBtn').addEventListener('click', exportStudentList);

  $('#parseWechatBtn').addEventListener('click', () => {
    const text = $('#wechatText').value;
    if (!text.trim()) { toast('请先粘贴群成员文本'); return; }
    const parsed = parseWechatMembers(text);
    if (parsed.length === 0) { toast('未解析到有效姓名，请检查粘贴内容'); return; }
    importPreview = parsed;
    renderImportPreview();
    toast(`解析出 ${parsed.length} 位成员，请确认后导入`);
    setTimeout(() => {
      $('#previewCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 120);
  });

  $('#clearWechatBtn').addEventListener('click', () => {
    $('#wechatText').value = '';
    importPreview = [];
    renderImportPreview();
  });

  $('#importPreview').addEventListener('click', e => {
    const cb = e.target.closest('input[data-act="check"]');
    if (cb) {
      importPreview[+cb.dataset.idx].checked = cb.checked;
    }
  });
  $('#importPreview').addEventListener('input', e => {
    const inp = e.target.closest('input[data-act="name"]');
    if (inp) importPreview[+inp.dataset.idx].name = inp.value;
  });

  $('#prevAll').addEventListener('click', () => {
    importPreview.forEach(x => x.checked = true); renderImportPreview();
  });
  $('#prevNone').addEventListener('click', () => {
    importPreview.forEach(x => x.checked = false); renderImportPreview();
  });
  $('#confirmImport').addEventListener('click', confirmImport);

  $('#excelBtn').addEventListener('click', () => $('#excelFile').click());
  $('#excelFile').addEventListener('change', e => {
    const f = e.target.files && e.target.files[0];
    if (f) handleExcelFile(f);
    e.target.value = '';
  });

  $('#exportBtn').addEventListener('click', exportExcel);
  $('#clearRecords').addEventListener('click', resetRound);
}

/* ================= 启动 ================= */
function init() {
  load();
  bindEvents();

  $$('.mode-btn').forEach(b => b.classList.toggle('active', b.dataset.mode === mode));

  renderAll();
  renderImportPreview();

  if (records.length > 0) {
    const last = records[records.length - 1];
    const stu = students.find(s => s.id === last.studentId);
    if (stu) {
      currentStudentId = stu.id;
      currentRecordId = last.id;
      showCurrent(stu);
      if (last.status) $('#pickMeta').textContent += '（已标记）';
    }
  }

  if (students.length === 0) {
    setTimeout(() => toast('欢迎使用！先去「导入」页添加学生名单 👉', 3200), 700);
  }

  // 更新 XLSX 加载状态提示
  const statusEl = $('#xlsxStatus');
  if (statusEl) {
    setTimeout(() => {
      if (typeof XLSX !== 'undefined') {
        statusEl.innerHTML = '✅ Excel 组件已就绪（支持 .xlsx / .xls / .csv）';
        statusEl.style.color = '#15803d';
      } else if (window.__XLSX_LOAD_FAILED__) {
        statusEl.innerHTML = '⚠️ Excel 组件加载失败，请改用 <b>CSV 格式</b>（Excel 另存为 CSV 即可），功能完整可用。';
        statusEl.style.color = '#b45309';
      } else {
        statusEl.innerHTML = '⏳ 正在加载 Excel 组件…';
        statusEl.style.color = '#6b7280';
      }
    }, 1500);
  }
}

document.addEventListener('DOMContentLoaded', init);
</script>
